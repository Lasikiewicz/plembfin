---
import SiteLayout from "../layouts/SiteLayout.astro";
import ScreenshotFigure from "../components/ScreenshotFigure.astro";
import IntegrationRail from "../components/IntegrationRail.astro";
import ReleaseSummary from "../components/ReleaseSummary.astro";
import { comparison, featureStories, features, integrations, site } from "../data/site.js";
import release from "../generated/release.json";
---

<SiteLayout title="One local archive for every screen.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Your watch history, <em>in sync.</em></h1>
      <p>
        Plembfin is the local bridge between your media servers, Trakt, and the metadata tools around them. It remembers what you watched, helps you find what to watch next, and keeps the rest of your library honest.
      </p>
      <div class="button-row" style="margin-top: var(--space-6);">
        <a class="button-primary" href="/docs/getting-started/">Get started</a>
        <a class="button-secondary" href="/docs/">Explore documentation</a>
      </div>
      <p class="hero-note"><span class="status-dot" aria-hidden="true"></span> Self-hosted · local SQLite · open source</p>
    </div>

    <div class="hero-visual" aria-label="Plembfin dashboard preview">
      <ScreenshotFigure
        darkSrc="/assets/app-captures/dashboard-dark.png"
        lightSrc="/assets/app-captures/dashboard-light.png"
        alt="Plembfin dashboard showing Now Playing, Up Next, TV history, and movie history"
        loading="eager"
      />
    </div>
  </section>

  <section class="section" id="features" aria-labelledby="features-title">
    <div class="section-header">
      <div>
        <h2 id="features-title">Everything you need, built in.</h2>
      </div>
      <p>
        A focused set of tools for keeping watch history accurate, discovering new titles, and making your library easy to browse.
      </p>
    </div>
    <div class="feature-grid">
      {features.map((feature) => (
        <div class="feature-card">
          <h3>{feature.title}</h3>
          <p>{feature.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="the-hub" aria-labelledby="hub-title">
    <div class="section-header">
      <div>
        <h2 id="hub-title">One archive. Every screen.</h2>
      </div>
      <p>
        Plex, Emby, Jellyfin, Trakt, and your metadata providers each know a different part of the story. Plembfin gives them one careful place to meet, with your watch history and personal media choices staying on your hardware.
      </p>
    </div>
    <div class="hub-layout">
      <a class="image-link" href="/assets/plembfin-hub.svg" data-lightbox-trigger="true" data-lightbox-caption="Plembfin keeps the local archive between media servers, watch history, metadata, and request tools." aria-label="Open image preview of the Plembfin connections diagram">
        <img src="/assets/plembfin-hub.svg" alt="Diagram showing Plembfin connecting media servers, Trakt, metadata providers, and request tools" loading="lazy" />
      </a>
      <div class="hub-copy">
        <h3>The brain in the middle.</h3>
        <p>Events come in, canonical state is recorded locally, and only the right changes go back out. Discovery and personal lists stay close at hand without becoming another public profile.</p>
        <ul class="signal-list">
          <li>Watched and unwatched state across connected services</li>
          <li>Resume progress that travels with the title</li>
          <li>Sync activity that explains what happened and why</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="why-plembfin" aria-labelledby="why-title">
    <div class="section-header">
      <div>
        <h2 id="why-title">Why Plembfin.</h2>
      </div>
      <p>
        Plembfin now covers the useful personal layer too: discovery, a watchlist, ratings, and custom lists. The boundary stays clear: those choices are private and local, while watched state remains canonical, explainable, and recoverable across your connected services.
      </p>
    </div>
    <div class="compare-table-wrap">
      <table class="compare-table">
        <thead>
          <tr>
            <th scope="col">&nbsp;</th>
            {comparison.columns.map((column) => <th scope="col">{column}</th>)}
          </tr>
        </thead>
        <tbody>
          {comparison.rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.values.map((value, index) => (
                <td class:list={{ "is-plembfin": index === 0 }}>{value}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section" id="capabilities" aria-labelledby="capabilities-title">
    <div class="section-header">
      <div>
        <h2 id="capabilities-title">Built for the library you already have.</h2>
      </div>
      <p>
        The useful part is not another place to click “watched”. It is a reliable view of your media ecosystem, from the first play to the next restore.
      </p>
    </div>

    <div class="story-list">
      {featureStories.map((story, index) => (
        <article class:list={["story", { "is-reverse": index % 2 === 1 }]} id={story.id}>
          <div class="story-copy">
            <h3>{story.title}</h3>
            <p>{story.text}</p>
            <ul class="story-bullets">
              {story.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
            <a class="button-secondary story-action" href={story.link}>{story.linkLabel}</a>
          </div>
          <ScreenshotFigure darkSrc={story.imageDark} lightSrc={story.imageLight} alt={story.imageAlt} caption={story.imageAlt} />
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="ecosystem" aria-labelledby="ecosystem-title">
    <div class="section-header">
      <div>
        <h2 id="ecosystem-title">Your stack, in one view.</h2>
      </div>
      <p>
        Connect at least one media server, then add the services that make your setup more useful. Each provider has a focused job, and the documentation explains the boundaries.
      </p>
    </div>
    <div class="integration-wrap">
      <IntegrationRail integrations={integrations} />
    </div>
  </section>

  <section class="section" id="setup" aria-labelledby="setup-title">
    <div class="section-header">
      <div>
        <h2 id="setup-title">From container to private archive.</h2>
      </div>
      <p>
        Start small, verify the instance, and connect a media server when you are ready. The setup guide is resumable, so there is no need to configure everything in one sitting.
      </p>
    </div>
    <div class="steps">
      <div class="step"><span class="step-number">01</span><h3>Run Plembfin</h3><p>Launch the published Docker image or start the Node app on your own hardware.</p></div>
      <div class="step"><span class="step-number">02</span><h3>Claim the instance</h3><p>Create the administrator account that controls this private archive.</p></div>
      <div class="step"><span class="step-number">03</span><h3>Connect what you use</h3><p>Test Plex, Emby, or Jellyfin and import the history you already have, whenever you are ready.</p></div>
      <div class="step"><span class="step-number">04</span><h3>Browse and reconcile</h3><p>Discover titles, save personal lists, then add webhooks, Trakt, metadata, and backups as your setup grows.</p></div>
    </div>
    <div class="button-row" style="margin-top: var(--space-7);">
      <a class="button-primary" href="/docs/getting-started/">Read the setup guide</a>
      <a class="button-secondary" href={site.repository} target="_blank" rel="noreferrer">View the repository</a>
    </div>
  </section>

  <section class="section release-section" id="release" aria-labelledby="release-title">
    <div>
      <h2 id="release-title">Kept current with the app.</h2>
      <p>
        The public site is built alongside Plembfin. Release details, runtime requirements, and documentation coverage are checked from the same repository sources.
      </p>
    </div>
    <ReleaseSummary release={release} />
  </section>
</SiteLayout>
