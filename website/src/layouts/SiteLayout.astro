---
import { site } from "../data/site.js";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/site.css";

const {
  title,
  description = site.description,
  image = "/assets/app-captures/dashboard-dark.png",
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${site.name} - ${title}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const previewBranch = import.meta.env.MODE !== "development" && process.env.CF_PAGES_BRANCH && process.env.CF_PAGES_BRANCH !== "main";
const robots = noindex || previewBranch ? "noindex,nofollow" : "index,follow";
const traksScriptUrl = import.meta.env.PUBLIC_TRAKS_SCRIPT_URL ?? "";
const traksSiteKey = import.meta.env.PUBLIC_TRAKS_SITE_KEY ?? "";
const traksRequireConsent = import.meta.env.PUBLIC_TRAKS_REQUIRE_CONSENT !== "false";
const traksUrlIsSafe = (() => {
  try {
    return new URL(traksScriptUrl).protocol === "https:";
  } catch {
    return false;
  }
})();
const traksEnabled = Boolean(traksScriptUrl && traksSiteKey && traksUrlIsSafe);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#05080c" data-theme-color />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Plembfin" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site.url).href} />
    <script is:inline>
      (() => {
        const themeKey = "plembfin:theme";
        let savedTheme = null;

        try {
          savedTheme = window.localStorage.getItem(themeKey);
        } catch {
          // Continue with the system preference when storage is unavailable.
        }

        const useLightMode = savedTheme === "light" || (savedTheme === null && !window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("light-mode", useLightMode);
        document.documentElement.dataset.theme = useLightMode ? "light" : "dark";
        document.querySelector("[data-theme-color]")?.setAttribute("content", useLightMode ? "#ffffff" : "#05080c");
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />

    {traksEnabled && traksRequireConsent && (
      <aside class="analytics-consent" data-analytics-consent hidden aria-labelledby="analytics-consent-title">
        <div class="analytics-consent-copy">
          <p class="analytics-consent-title" id="analytics-consent-title">Help improve Plembfin</p>
          <p>Allow Plembfin to share page views, time-on-page, browser/device details, referrer, and a coarse region with Traks to improve this website. No cookies are used.</p>
        </div>
        <div class="analytics-consent-actions">
          <button type="button" data-analytics-decline>Decline</button>
          <button type="button" data-analytics-accept>Allow analytics</button>
        </div>
      </aside>
    )}

    <dialog class="image-lightbox" data-image-lightbox aria-labelledby="image-lightbox-title" aria-describedby="image-lightbox-caption">
      <div class="image-lightbox-shell">
        <div class="image-lightbox-toolbar">
          <p class="image-lightbox-title" id="image-lightbox-title">Image preview</p>
          <div class="image-lightbox-controls" role="group" aria-label="Image controls">
            <button class="image-lightbox-control" type="button" data-lightbox-zoom-out aria-label="Zoom out">−</button>
            <button class="image-lightbox-control image-lightbox-zoom-reset" type="button" data-lightbox-zoom-reset aria-label="Reset zoom">100%</button>
            <button class="image-lightbox-control" type="button" data-lightbox-zoom-in aria-label="Zoom in">+</button>
            <button class="image-lightbox-control" type="button" data-lightbox-close>Close</button>
          </div>
        </div>
        <div class="image-lightbox-stage" data-lightbox-stage>
          <img data-lightbox-image alt="" width="1440" height="900" decoding="async" />
        </div>
        <p class="image-lightbox-caption" id="image-lightbox-caption" data-lightbox-caption></p>
      </div>
    </dialog>
    <script>
  const imageLightbox = document.querySelector("[data-image-lightbox]");

  if (imageLightbox instanceof HTMLDialogElement) {
    const lightboxImage = imageLightbox.querySelector("[data-lightbox-image]") as HTMLImageElement | null;
    const lightboxStage = imageLightbox.querySelector("[data-lightbox-stage]") as HTMLElement | null;
    const lightboxCaption = imageLightbox.querySelector("[data-lightbox-caption]") as HTMLElement | null;
    const zoomReset = imageLightbox.querySelector("[data-lightbox-zoom-reset]") as HTMLButtonElement | null;
    const closeButton = imageLightbox.querySelector("[data-lightbox-close]") as HTMLButtonElement | null;
    let lastTrigger: HTMLElement | null = null;
    let scale = 1;
    let translateX = 0;
    let translateY = 0;
    let isDragging = false;
    let dragMoved = false;
    let pointerStartX = 0;
    let pointerStartY = 0;
    let dragOriginX = 0;
    let dragOriginY = 0;

    const clampPan = () => {
      if (!(lightboxImage instanceof HTMLImageElement) || !(lightboxStage instanceof HTMLElement) || scale <= 1) {
        translateX = 0;
        translateY = 0;
        return;
      }

      const maxX = Math.max(0, (lightboxImage.offsetWidth * scale - lightboxStage.clientWidth) / 2 + 24);
      const maxY = Math.max(0, (lightboxImage.offsetHeight * scale - lightboxStage.clientHeight) / 2 + 24);
      translateX = Math.min(maxX, Math.max(-maxX, translateX));
      translateY = Math.min(maxY, Math.max(-maxY, translateY));
    };

    const setTransform = () => {
      clampPan();

      if (lightboxImage instanceof HTMLImageElement) {
        lightboxImage.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;
        lightboxImage.style.cursor = isDragging ? "grabbing" : scale > 1 ? "grab" : "zoom-in";
        lightboxImage.classList.toggle("is-dragging", isDragging);
      }
    };

    const setScale = (nextScale: number) => {
      scale = Math.min(3.5, Math.max(1, nextScale));
      if (scale <= 1) {
        translateX = 0;
        translateY = 0;
      }
      setTransform();

      if (zoomReset instanceof HTMLButtonElement) {
        zoomReset.textContent = `${Math.round(scale * 100)}%`;
      }
    };

    const closeLightbox = () => {
      if (imageLightbox.open) imageLightbox.close();
    };

    document.addEventListener("click", (event: MouseEvent) => {
      if (!(event.target instanceof Element)) return;

      const trigger = event.target.closest("[data-lightbox-trigger]");
      if (!(trigger instanceof HTMLAnchorElement) || !(lightboxImage instanceof HTMLImageElement)) return;

      const href = trigger.getAttribute("href");
      if (!href || imageLightbox.open) return;

      event.preventDefault();
      lastTrigger = trigger;
      const sourceImage = trigger.querySelector("img");
      lightboxImage.src = href;
      lightboxImage.alt = sourceImage?.getAttribute("alt") || "";

      if (lightboxCaption instanceof HTMLElement) {
        lightboxCaption.textContent = trigger.getAttribute("data-lightbox-caption") || lightboxImage.alt;
      }

      translateX = 0;
      translateY = 0;
      setScale(1);
      imageLightbox.showModal();
      closeButton?.focus();
    });

    imageLightbox.querySelector("[data-lightbox-close]")?.addEventListener("click", closeLightbox);
    imageLightbox.querySelector("[data-lightbox-zoom-in]")?.addEventListener("click", () => setScale(scale + 0.25));
    imageLightbox.querySelector("[data-lightbox-zoom-out]")?.addEventListener("click", () => setScale(scale - 0.25));
    zoomReset?.addEventListener("click", () => setScale(1));
    lightboxImage?.addEventListener("dragstart", (event) => event.preventDefault());
    lightboxImage?.addEventListener("pointerdown", (event) => {
      dragMoved = false;
      if (scale <= 1 || !(lightboxImage instanceof HTMLImageElement)) return;

      event.preventDefault();
      isDragging = true;
      pointerStartX = event.clientX;
      pointerStartY = event.clientY;
      dragOriginX = translateX;
      dragOriginY = translateY;
      lightboxImage.setPointerCapture(event.pointerId);
      setTransform();
    });
    lightboxImage?.addEventListener("pointermove", (event) => {
      if (!isDragging) return;

      const deltaX = event.clientX - pointerStartX;
      const deltaY = event.clientY - pointerStartY;
      if (Math.hypot(deltaX, deltaY) > 4) dragMoved = true;
      translateX = dragOriginX + deltaX;
      translateY = dragOriginY + deltaY;
      setTransform();
    });

    const endDrag = (event: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      if (lightboxImage instanceof HTMLImageElement && lightboxImage.hasPointerCapture(event.pointerId)) {
        lightboxImage.releasePointerCapture(event.pointerId);
      }
      setTransform();
    };

    lightboxImage?.addEventListener("pointerup", endDrag);
    lightboxImage?.addEventListener("pointercancel", endDrag);
    lightboxImage?.addEventListener("click", () => {
      if (dragMoved) {
        dragMoved = false;
        return;
      }
      setScale(scale > 1 ? 1 : 2);
    });
    lightboxImage?.addEventListener("load", setTransform);

    lightboxStage?.addEventListener("wheel", (event) => {
      if (!(event instanceof WheelEvent)) return;
      if (!imageLightbox.open) return;
      event.preventDefault();
      setScale(scale + (event.deltaY < 0 ? 0.25 : -0.25));
    }, { passive: false });

    imageLightbox.addEventListener("click", (event: MouseEvent) => {
      if (event.target === imageLightbox) closeLightbox();
    });

    imageLightbox.addEventListener("close", () => {
      if (lightboxImage instanceof HTMLImageElement) {
        lightboxImage.removeAttribute("src");
        lightboxImage.style.transform = "";
        lightboxImage.style.cursor = "";
        lightboxImage.classList.remove("is-dragging");
      }

      if (lightboxCaption instanceof HTMLElement) lightboxCaption.textContent = "";
      isDragging = false;
      translateX = 0;
      translateY = 0;
      setScale(1);
      if (lastTrigger instanceof HTMLElement) lastTrigger.focus();
      lastTrigger = null;
    });
  }
    </script>
    <script is:inline>
      const syncTheme = Reflect.get(window, "__plembfinSyncTheme");
      if (typeof syncTheme === "function") syncTheme();
    </script>
    {traksEnabled && (
      <script is:inline define:vars={{ traksScriptUrl, traksSiteKey, traksRequireConsent }}>
        (() => {
          const analyticsWindow = window;
          const consentBanner = document.querySelector("[data-analytics-consent]");
          const consentKey = "plembfin:analytics-consent";
          const hasPrivacySignal = navigator.doNotTrack === "1"
            || analyticsWindow.doNotTrack === "1"
            || navigator.globalPrivacyControl === true;

          const readConsent = () => {
            try {
              return analyticsWindow.localStorage.getItem(consentKey);
            } catch {
              return null;
            }
          };

          const writeConsent = (value) => {
            try {
              analyticsWindow.localStorage.setItem(consentKey, value);
            } catch {
              // A session-only choice still protects the visitor when storage is unavailable.
            }
          };

          const hideConsentBanner = () => {
            if (consentBanner instanceof HTMLElement) consentBanner.hidden = true;
          };

          const loadTraks = () => {
            if (
              analyticsWindow.__plembfinTraksLoaded
              || hasPrivacySignal
            ) return;
            if (traksRequireConsent && analyticsWindow.__plembfinAnalyticsConsent !== true) return;

            const script = document.createElement("script");
            script.defer = true;
            script.src = traksScriptUrl;
            script.dataset.site = traksSiteKey;
            script.onload = () => {
              analyticsWindow.__plembfinTraksLoaded = true;
            };
            document.head.appendChild(script);
          };

          if (traksRequireConsent) {
            const savedConsent = readConsent();
            if (savedConsent === "accepted") {
              analyticsWindow.__plembfinAnalyticsConsent = true;
              hideConsentBanner();
              loadTraks();
            } else if (savedConsent === "declined" || hasPrivacySignal) {
              hideConsentBanner();
            } else if (consentBanner instanceof HTMLElement) {
              consentBanner.hidden = false;
            }

            window.addEventListener("plembfin:analytics-consent", () => {
              analyticsWindow.__plembfinAnalyticsConsent = true;
              hideConsentBanner();
              loadTraks();
            }, { once: true });

            consentBanner?.querySelector("[data-analytics-accept]")?.addEventListener("click", () => {
              writeConsent("accepted");
              window.dispatchEvent(new Event("plembfin:analytics-consent"));
            });
            consentBanner?.querySelector("[data-analytics-decline]")?.addEventListener("click", () => {
              writeConsent("declined");
              hideConsentBanner();
            });
          } else if ("requestIdleCallback" in window) {
            window.requestIdleCallback(loadTraks, { timeout: 2000 });
          } else {
            window.setTimeout(loadTraks, 2000);
          }
        })();
      </script>
    )}
    <style is:inline>
      .analytics-consent[hidden] {
        display: none !important;
      }

      .analytics-consent {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 20;
        display: flex;
        align-items: center;
        gap: 1rem;
        max-width: min(42rem, calc(100vw - 2rem));
        padding: 1rem 1.1rem;
        color: #f7fafc;
        background: rgba(10, 16, 24, 0.96);
        border: 1px solid rgba(151, 180, 204, 0.35);
        border-radius: 0.8rem;
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.35);
      }

      .analytics-consent-copy {
        flex: 1 1 auto;
      }

      .analytics-consent-copy p {
        margin: 0;
        font-size: 0.82rem;
        line-height: 1.45;
      }

      .analytics-consent-title {
        margin-bottom: 0.25rem !important;
        font-weight: 700;
      }

      .analytics-consent-actions {
        display: flex;
        flex: 0 0 auto;
        gap: 0.5rem;
      }

      .analytics-consent-actions button {
        min-height: 2.4rem;
        padding: 0.55rem 0.8rem;
        color: inherit;
        background: transparent;
        border: 1px solid rgba(151, 180, 204, 0.5);
        border-radius: 0.45rem;
        cursor: pointer;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 700;
      }

      .analytics-consent-actions button:last-child {
        color: #071018;
        background: #8ed1ff;
        border-color: #8ed1ff;
      }

      @media (max-width: 38rem) {
        .analytics-consent {
          display: block;
        }

        .analytics-consent-actions {
          margin-top: 0.8rem;
        }
      }
    </style>
    <script>
      const backToTop = document.querySelector("[data-back-to-top]");

      if (backToTop instanceof HTMLButtonElement) {
        const updateBackToTop = () => {
          backToTop.hidden = window.scrollY < 520;
        };

        backToTop.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        });

        window.addEventListener("scroll", updateBackToTop, { passive: true });
        updateBackToTop();
      }
    </script>
  </body>
</html>
