node_modules/
dist/
.env
.env.*
!.env.example
.random
scratch/

# Local planning artifacts
plan/

# Local runtime data: SQLite database, cached artwork, generated config.json
data/
# The static documentation site has a tracked source index under its own data directory.
!website/src/data/
!website/src/data/app-surface.json

# Local data-directory archives. These contain config.json (admin password hash,
# API key, session secret) and the full watch-history database, and run to hundreds
# of megabytes, so they must never be staged.
backups/

# Local editor/agent tooling. `.claude/skills/` is the exception: the release
# procedures live there and CLAUDE.md points at them, so they must reach a clone.
# Everything else under `.claude/` stays local, including settings.local.json and
# local-environment.md, which hold machine-specific paths and credentials.
.claude/*
!.claude/skills/
# Personal feature-request monitoring workflow and its public-state snapshot.
.claude/check-requests.md
.claude/check-requests-state.json
.reasonix/
.Jules/
reasonix.toml

# Local dependency/tool caches and temporary website verification output
.tools/
.tmp-website-build/

# Derived at build time by website/scripts/build-release-data.mjs, from origin/main
# when that ref resolves and the working tree otherwise. Committing it let it drift
# (it sat at 1.0.2 while the repo was at 1.1.0) and both the website build and predev
# regenerate it, so it is not tracked. See docs/decisions.md entry 18.
website/src/generated/release.json
